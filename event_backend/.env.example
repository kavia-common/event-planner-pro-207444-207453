# Database (provided by the 'database' container integration)
POSTGRES_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# CORS
# Comma-separated list, e.g. "http://localhost:3000,https://myapp.com"
CORS_ALLOW_ORIGINS=*

# Supabase JWT verification (choose ONE mode)
# RS256 (recommended)
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# HS256 (alternative)
SUPABASE_JWT_SECRET=
